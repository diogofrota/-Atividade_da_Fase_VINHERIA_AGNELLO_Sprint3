              <zone forceUpdate='true' h='70500' id='15' type-v2='text' w='16000' x='83200' y='22500'>
                <formatted-text>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>📊 Vendas por Plataforma</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>O canal </run>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Site</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> teve destaque nas vendas com pagamento via cartão e Pix.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>O </run>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>WhatsApp</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> também apresentou boa participação.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>🌎 Região</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>O </run>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Sudeste</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> concentrou o maior volume de vendas, seguido pelo Sul e Nordeste.</run>
